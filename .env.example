# Public site URL used for canonical links, sitemap and Open Graph
SITE_URL=https://www.ayudisha.in
# "production" enables indexing; anything else sets noindex + disallow-all robots
SITE_ENV=preview

# Durable enquiry storage. No production adapter ships yet: implement lib/storage/postgres.ts
# against the StorageAdapter interface, then set this. Without it, production forms are disabled.
DATABASE_URL=

# Optional lead notification (server-side only)
EMAIL_PROVIDER_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=

# Only set to true after the owner confirms the number is on WhatsApp Business
ENABLE_WHATSAPP=false

# Salt for hashing IPs/phones in the rate limiter and duplicate check
HASH_SALT=change-me
